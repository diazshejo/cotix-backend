DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# CORS/CSRF examples:
# local frontend: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# staging/production frontend: https://staging.example.com,https://app.example.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Use DATABASE_URL or the DB_* variables below.
DATABASE_URL=
DB_NAME=cotix_dev
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=

JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=cotix_refresh
REFRESH_TOKEN_COOKIE_PATH=/api/auth/
REFRESH_TOKEN_COOKIE_SECURE=False
REFRESH_TOKEN_COOKIE_SAMESITE=Lax
ACCESS_TOKEN_COOKIE_NAME=cotix_access
ACCESS_TOKEN_COOKIE_PATH=/api/
ACCESS_TOKEN_COOKIE_SECURE=False
ACCESS_TOKEN_COOKIE_SAMESITE=Lax

# --- Email ---
# En desarrollo (DEBUG=True) settings.py fuerza console.EmailBackend
# sin importar las variables de abajo.
#
# Desarrollo — emails se imprimen en consola:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Cotix <no-reply@cotix.local>
#
# Produccion via Resend SMTP (https://resend.com):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=465
#   EMAIL_HOST_USER=resend
#   EMAIL_HOST_PASSWORD=re_XXXXXXXXXXXXXXXXXXXXXXXX
#   EMAIL_USE_TLS=False
#   EMAIL_USE_SSL=True
#   DEFAULT_FROM_EMAIL=Cotix <no-reply@tudominio.com>
FRONTEND_URL=http://localhost:5173

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
TRUST_PROXY_SSL_HEADER=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
USE_X_FORWARDED_HOST=False

LOG_LEVEL=INFO
LOGIN_FAILED_LIMIT=5
LOGIN_FAILED_WINDOW_MINUTES=10
LOGIN_LOCKOUT_MINUTES=15
