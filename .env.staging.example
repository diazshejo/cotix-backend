DJANGO_SECRET_KEY=replace-with-a-strong-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api-staging.cotix.example

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=https://staging.cotix.example
CSRF_TRUSTED_ORIGINS=https://staging.cotix.example

DATABASE_URL=postgresql://cotix_staging_user:replace-password@postgres:5432/cotix_staging
DB_SCHEMA=

JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=cotix_refresh
REFRESH_TOKEN_COOKIE_PATH=/api/auth/
REFRESH_TOKEN_COOKIE_SECURE=True
REFRESH_TOKEN_COOKIE_SAMESITE=None

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Cotix Staging <no-reply@staging.cotix.example>
FRONTEND_URL=https://staging.cotix.example

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=False
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
USE_X_FORWARDED_HOST=True

LOG_LEVEL=INFO
LOGIN_FAILED_LIMIT=5
LOGIN_FAILED_WINDOW_MINUTES=10
LOGIN_LOCKOUT_MINUTES=15
